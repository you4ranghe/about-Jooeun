# Supabase 연결 정보
#
# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요.
#   cp .env.example .env.local
#
# .env.local 은 .gitignore 에 걸려 있어 저장소에 올라가지 않습니다.
# Vercel 에는 프로젝트 설정 > Environment Variables 에 같은 값을 넣습니다.
#
# 값 찾는 곳: Supabase 대시보드 > Project Settings > API

# 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# anon (public) 키
#
# 이 키는 브라우저 번들에 그대로 들어갑니다. 그래도 괜찮습니다 —
# 애초에 공개를 전제로 만들어진 키이고, 무엇을 읽고 쓸 수 있는지는 RLS 가 정합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ service_role 키는 여기에도, 어디에도 넣지 마세요.
#    이 앱은 service_role 을 쓰지 않습니다. 권한 상승은 오직 JWT 의 role 클레임으로만
#    일어나고 판단은 RLS 가 합니다.
#    service_role 키에 NEXT_PUBLIC_ 접두사가 붙는 순간 RLS 전체가 무의미해지고,
#    배포된 JS 파일에서 누구나 꺼내 갈 수 있습니다.
